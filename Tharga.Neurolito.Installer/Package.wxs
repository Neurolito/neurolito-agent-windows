<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    The Neurolito Agent for Windows: the agent as a Windows service, llama.cpp for it to run models with, and the
    screensaver. Per machine, into Program Files; its data (models, logs) in ProgramData\Neurolito.

    The files are a Velopack package's portable layout - Update.exe, and the release in current\ - so the agent updates
    itself after this installs it: its service account may write the install folder, and Velopack replaces current\.
    This installer therefore installs the first version and the service, and removes them; it does not repair, which
    would put the first version back.

    Silent install:
      msiexec /i NeurolitoAgent.msi /qn TEAMKEY=<key> [ENERGYMODE=Never|WhileWorking|WhileReady] [SETSCREENSAVER=0] [SCREENSAVERMINUTES=10]
    TEAMKEY, ENERGYMODE, SCREENSAVERMINUTES, SERVERADDRESS and UPDATESOURCE are kept on upgrade when not given again.
  -->
  <Package Name="Neurolito Agent" Manufacturer="Neurolito" Version="$(var.Version)"
           UpgradeCode="bd2bbd7b-e529-4825-86dd-d5f6f3008183" Scope="perMachine" Compressed="yes">

    <SummaryInformation Description="Neurolito Agent for Windows" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of the Neurolito Agent is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://neurolito.com" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Neurolito/neurolito-agent-windows" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!--
      The team key is written to a file only the service and administrators can read, and only when one is given: an
      upgrade without it keeps the key already there. The other settings are kept from the installed version when not
      given again.
    -->
    <Property Id="TEAMKEY" Secure="yes" Hidden="yes" />

    <Property Id="ENERGYMODE" Secure="yes" />
    <Property Id="SAVED_ENERGYMODE" Secure="yes">
      <RegistrySearch Id="SavedEnergyMode" Root="HKLM" Key="SOFTWARE\Neurolito\Agent" Name="Desktop:EnergyMode" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="KeepEnergyMode" Id="ENERGYMODE" Value="[SAVED_ENERGYMODE]" After="AppSearch" Condition="NOT ENERGYMODE AND SAVED_ENERGYMODE" Sequence="both" />
    <SetProperty Action="DefaultEnergyMode" Id="ENERGYMODE" Value="Never" After="KeepEnergyMode" Condition="NOT ENERGYMODE" Sequence="both" />
    <!-- The page's radio buttons hold a copy, shown as the current setting and handed back on Next. -->
    <Property Id="UI_ENERGYMODE" Value="Never" />
    <SetProperty Action="ShowEnergyMode" Id="UI_ENERGYMODE" Value="[ENERGYMODE]" After="DefaultEnergyMode" Sequence="ui" />

    <!-- Where the agent connects. Empty means neurolito.com, as the agent's own settings say; set only for testing against another server. -->
    <Property Id="SERVERADDRESS" Secure="yes" />
    <Property Id="SAVED_SERVERADDRESS" Secure="yes">
      <RegistrySearch Id="SavedServerAddress" Root="HKLM" Key="SOFTWARE\Neurolito\Agent" Name="Tharga:Communication:ServerAddress" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="KeepServerAddress" Id="SERVERADDRESS" Value="[SAVED_SERVERADDRESS]" After="AppSearch" Condition="NOT SERVERADDRESS AND SAVED_SERVERADDRESS" Sequence="both" />

    <!-- Where updates come from: this repository's releases, or a folder or web address for testing. -->
    <Property Id="UPDATESOURCE" Secure="yes" />
    <Property Id="SAVED_UPDATESOURCE" Secure="yes">
      <RegistrySearch Id="SavedUpdateSource" Root="HKLM" Key="SOFTWARE\Neurolito\Agent" Name="Updates:Source" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="KeepUpdateSource" Id="UPDATESOURCE" Value="[SAVED_UPDATESOURCE]" After="AppSearch" Condition="NOT UPDATESOURCE AND SAVED_UPDATESOURCE" Sequence="both" />
    <SetProperty Action="DefaultUpdateSource" Id="UPDATESOURCE" Value="https://github.com/Neurolito/neurolito-agent-windows" After="KeepUpdateSource" Condition="NOT UPDATESOURCE" Sequence="both" />

    <!-- Make the Neurolito screensaver the installing user's own, starting after SCREENSAVERMINUTES. Never for other users. -->
    <Property Id="SETSCREENSAVER" Value="1" Secure="yes" />

    <!--
      How long the computer is idle before the screensaver starts - and so before the agent may work. Windows keeps it in
      seconds; an installer cannot multiply without a script action, so the minutes are one of a fixed list, each mapped
      to its seconds. Kept on upgrade, like the energy mode.
    -->
    <Property Id="SCREENSAVERMINUTES" Secure="yes" />
    <Property Id="SAVED_SCREENSAVERMINUTES" Secure="yes">
      <RegistrySearch Id="SavedScreensaverMinutes" Root="HKLM" Key="SOFTWARE\Neurolito\Agent" Name="Installer:ScreensaverMinutes" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="KeepScreensaverMinutes" Id="SCREENSAVERMINUTES" Value="[SAVED_SCREENSAVERMINUTES]" After="AppSearch" Condition="NOT SCREENSAVERMINUTES AND SAVED_SCREENSAVERMINUTES" Sequence="both" />
    <SetProperty Action="DefaultScreensaverMinutes" Id="SCREENSAVERMINUTES" Value="10" After="KeepScreensaverMinutes" Condition="NOT SCREENSAVERMINUTES" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds1" Id="SCREENSAVERSECONDS" Value="60" After="DefaultScreensaverMinutes" Condition="SCREENSAVERMINUTES = &quot;1&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds2" Id="SCREENSAVERSECONDS" Value="120" After="ScreensaverSeconds1" Condition="SCREENSAVERMINUTES = &quot;2&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds3" Id="SCREENSAVERSECONDS" Value="180" After="ScreensaverSeconds2" Condition="SCREENSAVERMINUTES = &quot;3&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds5" Id="SCREENSAVERSECONDS" Value="300" After="ScreensaverSeconds3" Condition="SCREENSAVERMINUTES = &quot;5&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds10" Id="SCREENSAVERSECONDS" Value="600" After="ScreensaverSeconds5" Condition="SCREENSAVERMINUTES = &quot;10&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds15" Id="SCREENSAVERSECONDS" Value="900" After="ScreensaverSeconds10" Condition="SCREENSAVERMINUTES = &quot;15&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds20" Id="SCREENSAVERSECONDS" Value="1200" After="ScreensaverSeconds15" Condition="SCREENSAVERMINUTES = &quot;20&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds30" Id="SCREENSAVERSECONDS" Value="1800" After="ScreensaverSeconds20" Condition="SCREENSAVERMINUTES = &quot;30&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds45" Id="SCREENSAVERSECONDS" Value="2700" After="ScreensaverSeconds30" Condition="SCREENSAVERMINUTES = &quot;45&quot;" Sequence="both" />
    <SetProperty Action="ScreensaverSeconds60" Id="SCREENSAVERSECONDS" Value="3600" After="ScreensaverSeconds45" Condition="SCREENSAVERMINUTES = &quot;60&quot;" Sequence="both" />
    <Launch Condition="Installed OR SETSCREENSAVER &lt;&gt; 1 OR SCREENSAVERSECONDS"
            Message="SCREENSAVERMINUTES must be one of 1, 2, 3, 5, 10, 15, 20, 30, 45, 60." />

    <Launch Condition="Installed OR TEAMKEY OR WIX_UPGRADE_DETECTED OR UILevel &gt;= 4"
            Message="The Neurolito Agent needs your team's install key: msiexec /i NeurolitoAgent.msi TEAMKEY=&lt;key&gt;. The install page on neurolito.com shows it." />

    <!--
      On a full uninstall, the data folder goes too - models, logs - and everything in the install folder, including the
      versions Velopack added after this installed the first. Not on an upgrade, which uninstalls the old version first.

      The paths are spelled from the system folders, not [INSTALLFOLDER] and [DataFolder]: RemoveFolderEx reads them
      before CostInitialize, and the directories are resolved only after it, so those were empty and nothing was swept.
      Neither folder can be chosen, so the spelling is the folder.
    -->
    <SetProperty Action="RemoveDataOnUninstall" Id="DATAFOLDER_TO_REMOVE" Value="[CommonAppDataFolder]Neurolito\" Before="CostInitialize"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" Sequence="execute" />
    <SetProperty Action="RemoveInstallOnUninstall" Id="INSTALLFOLDER_TO_REMOVE" Value="[ProgramFiles64Folder]Neurolito Agent\" Before="CostInitialize"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" Sequence="execute" />

    <!--
      Velopack's download cache, emptied on every install, upgrade and repair. Velopack applies a package it finds there
      when the agent starts, if it is newer - so one left from an earlier install overwrote the version just installed
      (NEPTUNUS, 2026-10-11: 0.1.2 installed, 0.2.1 running). At worst an update is downloaded again.
    -->
    <SetProperty Action="ClearUpdateCache" Id="UPDATECACHE_TO_REMOVE" Value="[ProgramFiles64Folder]Neurolito Agent\packages\" Before="CostInitialize"
                 Condition="NOT REMOVE~=&quot;ALL&quot;" Sequence="execute" />

    <Feature Id="Agent" Title="Neurolito Agent" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AgentRoot" />
      <ComponentGroupRef Id="AgentCurrent" />
      <ComponentRef Id="InstallFolder" />
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="Settings" />
      <ComponentRef Id="TeamKey" />
      <ComponentRef Id="ServerAddress" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="Screensaver" />
      <ComponentRef Id="ScreensaverSetting" />
    </Feature>

    <UIRef Id="NeurolitoUI" />
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Neurolito Agent">
        <Directory Id="CurrentFolder" Name="current" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="Neurolito">
        <Directory Id="ModelsFolder" Name="models" />
        <Directory Id="LogsFolder" Name="logs" />
        <Directory Id="SettingsFolder" Name="settings" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="System64Folder" />
  </Fragment>

  <Fragment>
    <!-- Velopack's own files at the root: Update.exe, its launcher and the portable marker. -->
    <ComponentGroup Id="AgentRoot" Directory="INSTALLFOLDER">
      <Files Include="$(var.AgentDir)\*" />
    </ComponentGroup>

    <!-- The release: the agent, llama.cpp in llama\, the screensaver in screensaver\. -->
    <ComponentGroup Id="AgentCurrent" Directory="CurrentFolder">
      <Files Include="$(var.AgentDir)\current\**">
        <Exclude Files="$(var.AgentDir)\current\Tharga.Neurolito.Agent.exe" />
      </Files>
    </ComponentGroup>

    <!--
      The install folder: the service may change it, to update itself; users may read it, since the screensaver they run
      is in it. Set as it is created, so every file installed into it inherits this. The service account is given by its
      SID - S-1-5-80 and the SHA-1 of NEUROLITOAGENT - because the permissions are set before the service exists.
    -->
    <Component Id="InstallFolder" Directory="INSTALLFOLDER" Guid="1f4e8a2b-6c3d-4e5f-8a9b-0c1d2e3f4a5b">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-3971261960-1095350057-3374866757-4235053908-3398681378)(A;OICI;0x1200a9;;;BU)" />
      </CreateFolder>
      <util:RemoveFolderEx On="uninstall" Property="INSTALLFOLDER_TO_REMOVE" />
      <util:RemoveFolderEx On="install" Property="UPDATECACHE_TO_REMOVE" />
    </Component>

    <!--
      The service runs as its own virtual account, NT SERVICE\NeurolitoAgent: least privilege, and the GPU works from it
      as from any account. It points into current\, which keeps its name across updates. Restarted if it stops, after
      30 s - which is also how an update finishes: the agent hands over to Update.exe and exits, and is started again on
      the new files.
    -->
    <Component Id="AgentService" Directory="CurrentFolder">
      <File Id="AgentExe" Source="$(var.AgentDir)\current\Tharga.Neurolito.Agent.exe" KeyPath="yes" />
      <ServiceInstall Id="AgentService" Name="NeurolitoAgent" DisplayName="Neurolito Agent"
                      Description="Runs language models for your Neurolito team while nobody is using this machine."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT SERVICE\NeurolitoAgent" Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="30" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="AgentService" Name="NeurolitoAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <!-- The agent's settings, read by the agent from this key. None of them is a secret; the team key is not here. -->
    <Component Id="Settings" Directory="INSTALLFOLDER" Guid="32951121-b444-4bc7-aa9d-6351890ae84d">
      <RegistryKey Root="HKLM" Key="SOFTWARE\Neurolito\Agent">
        <RegistryValue Name="Engine:Kind" Value="LlamaServer" Type="string" KeyPath="yes" />
        <RegistryValue Name="InstallFolder" Value="[INSTALLFOLDER]" Type="string" />
        <RegistryValue Name="LlamaServer:ExecutablePath" Value="[CurrentFolder]llama\llama-server.exe" Type="string" />
        <RegistryValue Name="LlamaServer:ModelsPath" Value="[ModelsFolder]" Type="string" />
        <RegistryValue Name="Desktop:Enabled" Value="true" Type="string" />
        <RegistryValue Name="Desktop:EnergyMode" Value="[ENERGYMODE]" Type="string" />
        <RegistryValue Name="Installer:ScreensaverMinutes" Value="[SCREENSAVERMINUTES]" Type="string" />
        <RegistryValue Name="Updates:Enabled" Value="true" Type="string" />
        <RegistryValue Name="Updates:Source" Value="[UPDATESOURCE]" Type="string" />
        <RegistryValue Name="Urls" Value="http://127.0.0.1:5180" Type="string" />
        <RegistryValue Name="Serilog:WriteTo:1:Args:path" Value="[LogsFolder]agent-.log" Type="string" />
      </RegistryKey>
    </Component>

    <Component Id="ServerAddress" Directory="INSTALLFOLDER" Guid="67a6bc79-85b7-4034-adb6-988f548c1003" Condition="SERVERADDRESS">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Neurolito\Agent" Name="Tharga:Communication:ServerAddress" Value="[SERVERADDRESS]" Type="string" KeyPath="yes" />
    </Component>

    <!-- Models and logs: written by the service, not by other users (ProgramData lets any user add files, so inheritance is cut). -->
    <Component Id="DataFolder" Directory="DataFolder" Guid="d3eded7b-6c9c-4df0-bcaf-1a74cd6e601d">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;S-1-5-80-3971261960-1095350057-3374866757-4235053908-3398681378)(A;OICI;0x1200a9;;;BU)" />
      </CreateFolder>
      <util:RemoveFolderEx On="uninstall" Property="DATAFOLDER_TO_REMOVE" />
    </Component>

    <!--
      The team key, a credential, in ProgramData\Neurolito\settings\agent.ini, which only the service and administrators
      can read. A file rather than a registry value, because Windows Installer applies a folder's permissions when it
      creates the folder, and a registry key's only in a case that a key with values never is. Permanent and written only
      when a key is given, so an upgrade keeps it; a full uninstall removes it with the data folder.

      Transitive, so the condition is asked again on a repair: without it a repair, which has no key, reinstalled the
      component and wrote ApiKey= empty, and the agent connected without its team (NEPTUNUS, 2026-10-11). Permanent keeps
      the file when the condition turns false. A repair given TEAMKEY writes the new key.
    -->
    <Component Id="TeamKey" Directory="SettingsFolder" Guid="7c0b3f6e-2a51-4c1e-9d8f-3b6a2e4f1c90" Permanent="yes" Transitive="yes" Condition="TEAMKEY">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;S-1-5-80-3971261960-1095350057-3374866757-4235053908-3398681378)" />
      </CreateFolder>
      <IniFile Id="TeamKey" Action="addLine" Directory="SettingsFolder" Name="agent.ini" Section="Tharga:Communication" Key="ApiKey" Value="[TEAMKEY]" />
    </Component>

    <!--
      In System32, where the screen saver settings look: a small launcher that never changes, starting the real
      screensaver from current\, so the screensaver is updated with the agent. Windows may start it by its short name.
    -->
    <Component Id="Screensaver" Directory="System64Folder" Guid="d8a7c199-6cf4-45c1-a4bf-ad35ac869864">
      <File Id="NeurolitoScr" Source="$(var.ScreensaverFile)" Name="Neurolito.scr" KeyPath="yes" />
    </Component>

    <Component Id="ScreensaverSetting" Directory="INSTALLFOLDER" Guid="24911280-d47e-4b28-84fc-7f996099b847" Condition="SETSCREENSAVER = 1">
      <RegistryKey Root="HKCU" Key="Control Panel\Desktop">
        <RegistryValue Name="SCRNSAVE.EXE" Value="[System64Folder]Neurolito.scr" Type="string" KeyPath="yes" />
        <RegistryValue Name="ScreenSaveActive" Value="1" Type="string" />
        <RegistryValue Name="ScreenSaveTimeOut" Value="[SCREENSAVERSECONDS]" Type="string" />
      </RegistryKey>
    </Component>
  </Fragment>
</Wix>
